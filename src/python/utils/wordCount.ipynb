        "def word_count(input_string: str) -> int:\n",
        "  \"\"\"\n",
        "  This function takes a string as input and returns the number of words in it.\n",
        "  \"\"\"\n",
        "  tokens = input_string.split(\" \")\n",
        "  return len(tokens)"
